# FastAPI Backend Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Model Configuration
MODEL_DIR=../ensemble_learning/saved_models

# Optional: API Keys for Real-time Data Integration
# Get free API keys from:
# - OpenWeatherMap: https://openweathermap.org/api
# - IQAir: https://www.iqair.com/air-pollution-data-api
# - Google Maps: https://developers.google.com/maps/documentation/geocoding

# OPENWEATHER_API_KEY=your_openweather_api_key_here
# IQAIR_API_KEY=your_iqair_api_key_here
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# CORS Configuration (comma-separated origins)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
