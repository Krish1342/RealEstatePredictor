# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL
VITE_API_URL=http://localhost:8000

# === MAPPING OPTIONS (Choose One) ===

# Option 1: OpenStreetMap + Leaflet (100% FREE, NO API KEY NEEDED) ⭐ RECOMMENDED
# No configuration needed - works out of the box!
# Just install: npm install leaflet react-leaflet

# Option 2: Mapbox (FREE up to 50,000 requests/month)
# Sign up: https://www.mapbox.com/
# VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Option 3: MapTiler (FREE up to 100,000 map loads/month)
# Sign up: https://www.maptiler.com/
# VITE_MAPTILER_KEY=your_maptiler_key_here

# === GEOCODING OPTIONS (Convert addresses to coordinates) ===

# Option 1: Nominatim/OSM (100% FREE, NO API KEY) ⭐ RECOMMENDED
# Endpoint: https://nominatim.openstreetmap.org/search
# Limit: 1 request/second (fair use policy)

# Option 2: Mapbox Geocoding (included in Mapbox free tier)
# Uses VITE_MAPBOX_TOKEN above

# === OPTIONAL SERVICES ===

# Analytics (Google Analytics, etc.)
# VITE_GA_TRACKING_ID=your_ga_tracking_id_here
